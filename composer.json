{
    "name": "openregion/image",
    "description": "PHP Image Processing",
    "homepage": "https://github.com/openregion/image",
    "keywords": [
        "image",
        "gd",
        "imagick",
        "watermark",
        "thumbnail",
        "resize"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Oliver Vogel",
            "email": "oliver@intervention.io",
            "homepage": "https://intervention.io"
        },
        {
            "name": "CIT Open Region",
            "homepage": "https://www.openregion.info/"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "arokettu/random-polyfill": "^1.0.6",
        "openregion/gif": "^5.0"
    },
    "replace": {
        "intervention/image": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "squizlabs/php_codesniffer": "^4",
        "slevomat/coding-standard": "~8.0"
    },
    "suggest": {
        "ext-exif": "Recommended to be able to read EXIF data properly."
    },
    "autoload": {
        "psr-4": {
            "Intervention\\Image\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Intervention\\Image\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
